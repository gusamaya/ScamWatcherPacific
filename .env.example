# Copy to .env for local testing. In production, set these in your host's
# environment settings instead of committing a file.

# --- Dashboard login ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Mailbox the inbox worker reads and replies from ---
EMAIL_ADDRESS=check@scamwatcherpacific.com
# Google Workspace / Gmail app password (not the normal account password)
EMAIL_PASSWORD=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# --- Website ---
# Where people are sent back to after using the website form
SITE_URL=https://scamwatcherpacific.com

# --- Privacy: must match what the website promises ---
# "Deleted after [X] days". 0 = never delete automatically.
RETENTION_DAYS=0
# Leave empty so nobody outside the review team gets a copy of replies.
AUDIT_BCC_EMAIL=

# --- Branding in replies and the dashboard ---
BRAND_NAME=ScamWatcher Pacific
BRAND_TAGLINE=Independent scam checking for Pacific communities
ADVISOR_NAME=The ScamWatcher Pacific team
ADVISOR_TITLE=
REFERENCE_PREFIX=SWP

# --- Storage ---
DB_PATH=/var/data/scamwatcherpacific.db
# UPLOAD_DIR defaults to an "uploads" folder next to the database
MAX_UPLOAD_MB=10

# --- Automatic screenshot review (Claude) ---
# Without a key, screenshots wait for a manual review.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AUTO_REVIEW_ENABLED=true

# --- Behaviour ---
# Keep false: every reply waits for "Approve and send". Screenshot submissions
# are never auto-sent, whatever this is set to.
AUTO_SEND_ENABLED=false
INBOX_WORKER_ENABLED=true
# Website form submissions allowed per address per hour
INTAKE_RATE_LIMIT=5
